<?xml version="1.0" encoding="UTF-8"?>
<system xmlns="http://www.eiffel.com/developers/xml/configuration-1-23-0"
        name="read_probe" uuid="B38BE489-BB86-4C74-A002-5824751C5903">
    <target name="read">
        <root class="READ_PROBE" feature="make"/>
        <option>
            <assertions precondition="true" postcondition="true" check="true" invariant="true" loop="true" supplier_precondition="true"/>
        </option>
        <setting name="console_application" value="true"/>
        <setting name="executable_name" value="read_probe"/>
        <capability>
            <void_safety support="all" use="all"/>
        </capability>
        <library name="arc" location="../arc.ecf" readonly="false">
        <option>
            <assertions precondition="true" postcondition="true" check="true" invariant="true" loop="true" supplier_precondition="true"/>
        </option>
        </library>
        <library name="free_elks" location="$GOBO/library/free_elks/library_ge.ecf">
            <condition><custom name="GOBO_EIFFEL" value="ge"/></condition>
        </library>
        <library name="base" location="$ISE_LIBRARY/library/base/base.ecf">
            <condition><custom name="GOBO_EIFFEL" excluded_value="ge"/></condition>
        </library>
        <external_include location="$ECF_CONFIG_PATH"/>
        <cluster name="probe" location="." recursive="false"/>
    </target>
</system>
